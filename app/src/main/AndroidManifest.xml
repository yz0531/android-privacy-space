<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.managed_users"
        android:required="false" />

    <permission
        android:name="com.example.privateentry.permission.OPEN_MANAGER"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.privateentry.permission.OPEN_MANAGER" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSTALL_PACKAGE" />
            <data
                android:mimeType="application/vnd.android.package-archive"
                android:scheme="content" />
        </intent>
        <intent>
            <action android:name="android.intent.action.OPEN_DOCUMENT" />
            <category android:name="android.intent.category.OPENABLE" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.UNINSTALL_PACKAGE" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".LauncherActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".ManagerActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:permission="com.example.privateentry.permission.OPEN_MANAGER">
            <intent-filter>
                <action android:name="com.example.privateentry.action.OPEN_MANAGER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PrivateHomeActivity"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:permission="com.example.privateentry.permission.OPEN_MANAGER"
            android:theme="@style/Theme.PrivateHome">
            <intent-filter>
                <action android:name="com.example.privateentry.action.OPEN_HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ManagedInstallActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="com.example.privateentry.permission.OPEN_MANAGER">
            <intent-filter>
                <action android:name="com.example.privateentry.action.INSTALL_IN_MANAGED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ParentInstallActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="com.example.privateentry.permission.OPEN_MANAGER">
            <intent-filter>
                <action android:name="com.example.privateentry.action.INSTALL_IN_PARENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PersonalApkImportActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false" />

        <activity
            android:name=".ManagedApkInstallActivity"
            android:configChanges="keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="com.example.privateentry.permission.OPEN_MANAGER">
            <intent-filter>
                <action android:name="com.example.privateentry.action.INSTALL_APK_IN_MANAGED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ParentApkCleanupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:permission="com.example.privateentry.permission.OPEN_MANAGER"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.example.privateentry.action.CLEANUP_APK_IN_PARENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ManagedRemoveActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="com.example.privateentry.permission.OPEN_MANAGER">
            <intent-filter>
                <action android:name="com.example.privateentry.action.DELETE_IN_MANAGED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ParentRemoveActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:permission="com.example.privateentry.permission.OPEN_MANAGER">
            <intent-filter>
                <action android:name="com.example.privateentry.action.DELETE_IN_PARENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProvisioningReadyActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="com.example.privateentry.permission.OPEN_MANAGER"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.example.privateentry.action.PROFILE_READY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProvisioningModeActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PolicyComplianceActivity"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProvisioningSuccessfulActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <intent-filter>
                <action android:name="android.app.action.PROVISIONING_SUCCESSFUL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".PrivacyAdminReceiver"
            android:description="@string/admin_description"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_receiver" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ProvisioningStatusReceiver"
            android:exported="true"
            android:permission="android.permission.MANAGE_PROFILE_AND_DEVICE_OWNERS">
            <intent-filter>
                <action android:name="android.app.action.MANAGED_PROFILE_PROVISIONED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ProfileRepairReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".SecretCodeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telephony.action.SECRET_CODE" />
                <data android:scheme="android_secret_code" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".ApkFileProvider"
            android:authorities="${applicationId}.apkfiles"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>

</manifest>
